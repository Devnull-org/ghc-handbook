---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { sourceUrl } from '../../lib/ghc';
import { chapterHref, withBase } from '../../lib/paths';

export async function getStaticPaths() {
  const chapters = (await getCollection('chapters')).sort((a, b) => a.data.order - b.data.order);
  return chapters.map((chapter, i) => ({
    params: { slug: chapter.id },
    props: {
      chapter,
      prev: i > 0 ? chapters[i - 1] : null,
      next: i < chapters.length - 1 ? chapters[i + 1] : null,
    },
  }));
}

const { chapter, prev, next } = Astro.props;
const { Content, headings } = await render(chapter);
const toc = headings.filter((h) => h.depth === 2);
---

<Base title={chapter.data.title} description={chapter.data.summary} width="page">
  <div class="layout">
    <article class="chapter" data-pagefind-body>
      <header>
        <p class="eyebrow">Chapter {chapter.data.order}</p>
        <h1>{chapter.data.title}</h1>
        <p class="summary">{chapter.data.summary}</p>
      </header>

      {
        chapter.data.sources.length > 0 && (
          <section class="sources" aria-label="Primary sources">
            <h2 class="sources-heading">Where this lives in the tree</h2>
            <ul>
              {chapter.data.sources.map((s) => (
                <li>
                  <a href={sourceUrl(s.file, 1)} rel="noopener">
                    <code>{s.file.replace(/^compiler\//, '')}</code>
                  </a>
                  <span>{s.blurb}</span>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <div class="prose">
        <Content />
      </div>

      <nav class="pager" aria-label="Chapter navigation">
        {
          prev ? (
            <a class="pager-link prev" href={chapterHref(prev.id)}>
              <span class="pager-dir">← Previous</span>
              <span class="pager-title">{prev.data.title}</span>
            </a>
          ) : (
            <a class="pager-link prev" href={withBase('/')}>
              <span class="pager-dir">←</span>
              <span class="pager-title">The pipeline</span>
            </a>
          )
        }
        {
          next && (
            <a class="pager-link next" href={chapterHref(next.id)}>
              <span class="pager-dir">Next →</span>
              <span class="pager-title">{next.data.title}</span>
            </a>
          )
        }
      </nav>
    </article>

    {
      toc.length > 1 && (
        <aside class="toc" aria-label="On this page">
          <h2>On this page</h2>
          <ul>
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </div>
</Base>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
  }
  @media (min-width: 62rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 12rem;
    }
  }

  .eyebrow {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--accent);
    margin: 0 0 0.5rem;
  }

  .summary {
    font-size: var(--step-1);
    color: var(--ink-muted);
    margin-bottom: 2.5rem;
  }

  .sources {
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    padding: 1rem 0;
    margin-bottom: 2.5rem;
  }
  .sources-heading {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--ink-faint);
    margin: 0 0 0.6rem;
  }
  .sources ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }
  .sources li {
    display: flex;
    gap: 0.8rem;
    align-items: baseline;
    font-size: var(--step--1);
    flex-wrap: wrap;
  }
  .sources code {
    font-size: 0.78rem;
  }
  .sources span {
    color: var(--ink-muted);
  }

  /* Prose is narrower than the interactive components it contains, which are
     allowed to use the full column width.
     Direct children only: a descendant selector would also clamp the paragraphs
     *inside* those components, cutting their backgrounds off mid-element. */
  .prose > :global(p),
  .prose > :global(ul),
  .prose > :global(ol),
  .prose > :global(h2),
  .prose > :global(h3),
  .prose > :global(blockquote) {
    max-width: var(--measure);
  }

  .prose > :global(h2) {
    padding-top: 0.6rem;
    border-top: 1px solid var(--rule);
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }
  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-decoration: none;
    font-family: var(--font-sans);
  }
  .pager-link.next {
    text-align: right;
    margin-left: auto;
  }
  .pager-dir {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-faint);
  }
  .pager-title {
    color: var(--link);
    font-size: var(--step--1);
  }

  .toc {
    font-family: var(--font-sans);
    font-size: 0.78rem;
  }
  @media (min-width: 62rem) {
    .toc {
      position: sticky;
      top: 5rem;
      align-self: start;
      max-height: calc(100vh - 7rem);
      overflow-y: auto;
    }
  }
  .toc h2 {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--ink-faint);
    margin: 0 0 0.6rem;
    font-weight: 600;
  }
  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
    border-left: 1px solid var(--rule);
  }
  .toc a {
    color: var(--ink-muted);
    text-decoration: none;
    display: block;
    padding-left: 0.7rem;
    margin-left: -1px;
    border-left: 1px solid transparent;
    line-height: 1.35;
  }
  .toc a:hover {
    color: var(--ink);
    border-left-color: var(--accent);
  }
</style>
