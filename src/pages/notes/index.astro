---
import Base from '../../layouts/Base.astro';
import { loadNotes, pin } from '../../lib/ghc';

const { notes, stats } = loadNotes();

// The client filters over a stripped-down index: titles and modules only, no
// bodies. 3,000+ rows stay instant and the payload stays a few hundred KB
// instead of the 6.8 MB the full corpus would cost.
const index = notes.map((n) => ({
  i: n.id,
  t: n.title,
  m: n.module ?? n.file,
  a: n.area,
  r: n.refsIn.length,
}));

const modules = [...new Set(notes.map((n) => n.module).filter(Boolean))] as string[];
// Group by top-level subsystem (GHC.Tc.*, GHC.Core.*) — the useful granularity.
const subsystems = new Map<string, number>();
for (const m of modules) {
  const parts = m.split('.');
  const key = parts.length >= 2 ? parts.slice(0, 2).join('.') : m;
  subsystems.set(key, (subsystems.get(key) ?? 0) + 1);
}
const topSubsystems = [...subsystems.entries()].sort((a, b) => b[1] - a[1]).slice(0, 14);
---

<Base
  title="Notes"
  description={`Every Note [...] comment in GHC ${pin.ghcVersion}, cross-linked and searchable.`}
  width="wide"
>
  <h1>The Note index</h1>
  <p class="lede">
    GHC records its design reasoning in <code>Note [...]</code> comments scattered through the
    source. There are <strong>{stats.notes!.toLocaleString()}</strong> of them in
    <code>{pin.tag}</code>, joined by <strong>{stats.resolved!.toLocaleString()}</strong> resolved
    cross-references. This index makes that graph navigable — something the source itself cannot
    offer.
  </p>

  <div class="controls">
    <label class="search">
      <span class="visually-hidden">Filter notes by title or module</span>
      <input
        type="search"
        id="note-filter"
        placeholder="Filter by title or module…"
        autocomplete="off"
        spellcheck="false"
      />
    </label>
    <label class="sort">
      <span class="visually-hidden">Sort order</span>
      <select id="note-sort">
        <option value="title">A–Z</option>
        <option value="refs">Most referenced</option>
        <option value="module">By module</option>
      </select>
    </label>
  </div>

  <div class="chips" role="group" aria-label="Filter by subsystem">
    <button type="button" class="chip is-active" data-subsystem="">All</button>
    {
      topSubsystems.map(([name, count]) => (
        <button type="button" class="chip" data-subsystem={name}>
          {name} <span class="chip-count">{count}</span>
        </button>
      ))
    }
  </div>

  <p class="result-count" id="result-count" aria-live="polite"></p>

  <ol class="note-list" id="note-list"></ol>

  <template id="row-template">
    <li class="row">
      <a class="row-title" href="#"></a>
      <span class="row-module"></span>
      <span class="row-refs" title="inbound references"></span>
    </li>
  </template>

  <script define:vars={{ index, base: import.meta.env.BASE_URL }}>
    const list = document.getElementById('note-list');
    const filterInput = document.getElementById('note-filter');
    const sortSelect = document.getElementById('note-sort');
    const countEl = document.getElementById('result-count');
    const template = document.getElementById('row-template');
    const chips = [...document.querySelectorAll('.chip')];

    let subsystem = '';
    const baseUrl = base.replace(/\/$/, '');

    function currentRows() {
      const q = filterInput.value.trim().toLowerCase();
      let rows = index;

      if (subsystem) rows = rows.filter((r) => r.m && r.m.startsWith(subsystem));
      if (q) rows = rows.filter((r) => r.t.toLowerCase().includes(q) || r.m.toLowerCase().includes(q));

      const sort = sortSelect.value;
      const sorted = [...rows];
      if (sort === 'refs') sorted.sort((a, b) => b.r - a.r || a.t.localeCompare(b.t));
      else if (sort === 'module') sorted.sort((a, b) => a.m.localeCompare(b.m) || a.t.localeCompare(b.t));
      else sorted.sort((a, b) => a.t.localeCompare(b.t));
      return sorted;
    }

    // Rendering 3,000 rows on every keystroke is wasteful; cap the DOM and tell
    // the reader when the list is truncated rather than silently hiding results.
    const RENDER_LIMIT = 400;

    function render() {
      const rows = currentRows();
      const shown = rows.slice(0, RENDER_LIMIT);

      const frag = document.createDocumentFragment();
      for (const r of shown) {
        const node = template.content.cloneNode(true);
        const a = node.querySelector('.row-title');
        a.textContent = r.t;
        a.href = `${baseUrl}/notes/${encodeURIComponent(r.i)}/`;
        node.querySelector('.row-module').textContent = r.m;
        const refs = node.querySelector('.row-refs');
        refs.textContent = r.r > 0 ? `${r.r}` : '';
        frag.append(node);
      }

      list.replaceChildren(frag);
      countEl.textContent =
        rows.length === index.length
          ? `${rows.length.toLocaleString()} notes`
          : `${rows.length.toLocaleString()} of ${index.length.toLocaleString()} notes` +
            (rows.length > RENDER_LIMIT ? ` — showing first ${RENDER_LIMIT}` : '');
    }

    filterInput.addEventListener('input', render);
    sortSelect.addEventListener('change', render);
    for (const chip of chips) {
      chip.addEventListener('click', () => {
        subsystem = chip.dataset.subsystem;
        for (const c of chips) c.classList.toggle('is-active', c === chip);
        render();
      });
    }

    render();
  </script>

  <style>
    .lede {
      color: var(--ink-muted);
      margin-bottom: 2rem;
    }

    .controls {
      display: flex;
      gap: 0.75rem;
      margin-bottom: 1rem;
    }
    .search {
      flex: 1;
    }
    input[type='search'],
    select {
      width: 100%;
      font-family: var(--font-sans);
      font-size: var(--step--1);
      padding: 0.5rem 0.7rem;
      border: 1px solid var(--rule-strong);
      border-radius: 4px;
      background: var(--paper-raised);
      color: var(--ink);
    }
    select {
      cursor: pointer;
    }

    .chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-bottom: 1.2rem;
    }
    .chip {
      font-family: var(--font-sans);
      font-size: 0.78rem;
      padding: 0.25rem 0.6rem;
      border: 1px solid var(--rule);
      border-radius: 100px;
      background: transparent;
      color: var(--ink-muted);
      cursor: pointer;
    }
    .chip:hover {
      border-color: var(--rule-strong);
      color: var(--ink);
    }
    .chip.is-active {
      background: var(--accent-soft);
      border-color: transparent;
      color: var(--accent);
      font-weight: 600;
    }
    .chip-count {
      color: var(--ink-faint);
      font-variant-numeric: tabular-nums;
    }

    .result-count {
      font-family: var(--font-sans);
      font-size: var(--step--1);
      color: var(--ink-faint);
      margin-bottom: 0.5rem;
    }

    .note-list {
      list-style: none;
      margin: 0;
      padding: 0;
      border-top: 1px solid var(--rule);
    }
    .note-list :global(.row) {
      display: grid;
      grid-template-columns: 1fr auto 3ch;
      gap: 1rem;
      align-items: baseline;
      padding: 0.5rem 0.2rem;
      border-bottom: 1px solid var(--rule);
    }
    .note-list :global(.row:hover) {
      background: var(--paper-raised);
    }
    .note-list :global(.row-title) {
      font-size: var(--step--1);
      text-decoration: none;
      color: var(--ink);
    }
    .note-list :global(.row-title:hover) {
      color: var(--link);
      text-decoration: underline;
    }
    .note-list :global(.row-module) {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      color: var(--ink-faint);
      text-align: right;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      max-width: 22ch;
    }
    .note-list :global(.row-refs) {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      color: var(--ink-faint);
      text-align: right;
      font-variant-numeric: tabular-nums;
    }

    @media (max-width: 34rem) {
      .note-list :global(.row-module) {
        display: none;
      }
    }
  </style>
</Base>
