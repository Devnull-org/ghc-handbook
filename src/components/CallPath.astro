---
/**
 * The call path a phase actually takes through GHC, drawn as a vertical flow
 * graph: caller above, callee below, an arrow for every call. Forks lay their
 * branches side by side under a shared connector. Every edge shown here was
 * verified against the pinned source by gen-journey.mjs, so this is the real
 * route, not a summary.
 */
interface Node {
  name: string;
  file: string;
  line: number;
  role: string;
  url: string;
  children: Node[];
}

interface Props {
  paths?: Node[];
  /** Internal: a single subtree during recursion. */
  node?: Node;
}

const { paths, node } = Astro.props;
const Self = Astro.self;
---

{
  paths ? (
    <div class="callpath">
      <div class="callpath-title">The path the compiler takes</div>
      <div class="scroll">
        {paths.map((root) => (
          <div class="flow">
            <Self node={root} />
          </div>
        ))}
      </div>
    </div>
  ) : node ? (
    <div class="chain">
      <div class="box">
        <a class="fn" href={node.url}>
          <code>{node.name}</code>
        </a>
        <span class="loc">{node.file.replace('compiler/GHC/', '')}:{node.line}</span>
        <span class="role">{node.role}</span>
      </div>
      {node.children.length === 1 && (
        <>
          <div class="arrow" aria-hidden="true" />
          <Self node={node.children[0]} />
        </>
      )}
      {node.children.length > 1 && (
        <>
          <div class="arrow no-head" aria-hidden="true" />
          <div class="branches">
            {node.children.map((c) => (
              <div class="branch">
                <div class="arrow branch-arrow" aria-hidden="true" />
                <Self node={c} />
              </div>
            ))}
          </div>
        </>
      )}
    </div>
  ) : null
}

<style>
  .callpath {
    margin: 1.5rem 0;
    border: 1px solid var(--rule, #ddd);
    border-radius: 6px;
    padding: 1rem 1.2rem 1.2rem;
  }
  .callpath-title {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-muted, #666);
    margin-bottom: 0.8rem;
  }
  .scroll {
    overflow-x: auto;
  }

  .flow + .flow {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--rule, #ddd);
  }

  .chain {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .box {
    display: grid;
    grid-template-columns: auto auto;
    gap: 0 0.7rem;
    align-items: baseline;
    border: 1px solid var(--rule-strong, #bbb);
    border-radius: 5px;
    background: var(--paper-raised, #fff);
    padding: 0.4rem 0.7rem;
    max-width: 34rem;
  }
  .fn {
    text-decoration: none;
  }
  .fn code {
    font-size: 0.85rem;
    font-weight: 600;
  }
  .loc {
    font-family: var(--font-mono, monospace);
    font-size: 0.68rem;
    color: var(--ink-faint, #999);
    white-space: nowrap;
  }
  .role {
    grid-column: 1 / -1;
    font-size: 0.8rem;
    color: var(--ink-muted, #666);
    line-height: 1.35;
  }

  /* The call: a short stem with an arrowhead, offset into the box's left side
     so the flow reads as a single descending spine. */
  .arrow {
    width: 0;
    height: 0.9rem;
    margin-left: 1.4rem;
    border-left: 1.5px solid var(--rule-strong, #bbb);
    position: relative;
  }
  .arrow::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: -4.5px;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 6px solid var(--rule-strong, #bbb);
  }

  .arrow.no-head {
    height: 0.55rem;
  }
  .arrow.no-head::after {
    display: none;
  }

  /* A fork: branches side by side. Each branch except the last draws the
     segment of the horizontal bar from its own stem across the gap to the
     next branch's stem, so the bar always ends exactly at the last stem. */
  .branches {
    display: flex;
    gap: 1.4rem;
    align-items: flex-start;
    padding-top: 0.55rem;
  }
  .branch {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    position: relative;
  }
  .branch:not(:last-child)::before {
    content: '';
    position: absolute;
    top: -0.55rem;
    left: 1.4rem;
    right: -2.8rem;
    border-top: 1.5px solid var(--rule-strong, #bbb);
  }
  .branch-arrow {
    height: 1.1rem;
    margin-top: -0.55rem;
  }

  @media (max-width: 44rem) {
    .branches {
      flex-direction: column;
      gap: 0.6rem;
      padding-top: 0;
    }
    .branch:not(:last-child)::before {
      display: none;
    }
    .branch-arrow {
      margin-top: 0;
      height: 0.9rem;
    }
  }
</style>
