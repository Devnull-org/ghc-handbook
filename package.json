{
  "name": "ghc-handbook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An interactive handbook for the GHC compiler",
  "scripts": {
    "fetch-src": "bash scripts/fetch-ghc-src.sh",
    "extract": "node scripts/extract-notes.mjs",
    "regen": "npm run fetch-src && npm run extract",
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "test": "node --test scripts/lib/*.test.mjs",
    "check": "astro check"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/node": "^26.1.2",
    "astro": "^5.6.1",
    "pagefind": "^1.3.0",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.2.3"
  }
}
